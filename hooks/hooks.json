{
  "description": "After a Bash command that looks like a deploy, remind the agent that only a production deploy that worked should tell Merle it's live. On a Mac paired with Merle, hook up each session so the founder's notes from Merle reach it: a check-in at start, a look for a note at the end of each turn, and a waiting hook that wakes an idle session when one comes.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/after-deploy.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-hook.mjs\" start",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-hook.mjs\" next-note",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-hook.mjs\" wait",
            "asyncRewake": true,
            "timeout": 86400
          }
        ]
      }
    ]
  }
}
